// Lightweight Prisma schema for Supabase PostgreSQL
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Set in Vercel and local .env
}

// Users table
model User {
  id        String  @id @default(cuid())
  email     String  @unique
  name      String?
  password  String
  role      String  @default("CLIENT") // CLIENT, SUPERADMIN
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// Automation logs (for tasks)
model AutomationLog {
  id        String   @id @default(cuid())
  taskName  String   @map("task_name")
  status    String
  durationMs Int?    @map("duration_ms")
  details   String?
  error     String?
  runTime   DateTime @default(now()) @map("run_time")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("automation_logs")
}

// Secrets storage
model Secret {
  id        String @id @default(cuid())
  key       String @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("secrets")
}
